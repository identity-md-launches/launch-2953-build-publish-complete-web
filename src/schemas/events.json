{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/d0_response",
  "$defs": {
    "d2_installationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "d1_unavailable": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "installationId": {
          "$ref": "#/$defs/d2_installationId"
        },
        "status": {
          "const": "unavailable"
        },
        "reason": {
          "enum": [
            "indexer_disabled",
            "not_yet_safe",
            "indexer_unavailable",
            "indexer_mismatch",
            "source_disabled"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "installationId",
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "d4_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "d5_activityCategory": {
      "enum": [
        "all",
        "protocol",
        "players",
        "measurement"
      ]
    },
    "d7_decimal": {
      "type": "string",
      "format": "uint256-decimal"
    },
    "d8_bytes32": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "d6_chain": {
      "type": "object",
      "properties": {
        "target": {
          "enum": [
            "anvil",
            "sepolia",
            "mainnet"
          ]
        },
        "chainId": {
          "$ref": "#/$defs/d7_decimal"
        },
        "confirmations": {
          "const": "12"
        },
        "deploymentBlock": {
          "$ref": "#/$defs/d7_decimal"
        },
        "economyDeploymentBlock": {
          "$ref": "#/$defs/d7_decimal"
        },
        "indexedThroughBlock": {
          "$ref": "#/$defs/d7_decimal"
        },
        "safeThroughBlock": {
          "$ref": "#/$defs/d7_decimal"
        },
        "safeBlockHash": {
          "$ref": "#/$defs/d8_bytes32"
        },
        "safeBlockTimestamp": {
          "$ref": "#/$defs/d4_timestamp"
        }
      },
      "required": [
        "target",
        "chainId",
        "confirmations",
        "deploymentBlock",
        "economyDeploymentBlock",
        "indexedThroughBlock",
        "safeThroughBlock",
        "safeBlockHash",
        "safeBlockTimestamp"
      ],
      "additionalProperties": false
    },
    "d10_versionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "d11_revisionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$"
    },
    "d9_release": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/d10_versionId"
        },
        "protocolRevision": {
          "$ref": "#/$defs/d11_revisionId"
        },
        "rewardModelRevision": {
          "$ref": "#/$defs/d11_revisionId"
        }
      },
      "required": [
        "id",
        "protocolRevision",
        "rewardModelRevision"
      ],
      "additionalProperties": false
    },
    "d13_address": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "d14_proxyIdentity": {
      "type": "object",
      "properties": {
        "proxy": {
          "$ref": "#/$defs/d13_address"
        },
        "implementation": {
          "$ref": "#/$defs/d13_address"
        },
        "implementationVersion": {
          "$ref": "#/$defs/d7_decimal"
        },
        "storageLayoutDigest": {
          "$ref": "#/$defs/d8_bytes32"
        }
      },
      "required": [
        "proxy",
        "implementation",
        "implementationVersion",
        "storageLayoutDigest"
      ],
      "additionalProperties": false
    },
    "d12_identities": {
      "type": "object",
      "properties": {
        "core": {
          "$ref": "#/$defs/d13_address"
        },
        "tokenFactory": {
          "$ref": "#/$defs/d13_address"
        },
        "token": {
          "$ref": "#/$defs/d13_address"
        },
        "genesis": {
          "$ref": "#/$defs/d13_address"
        },
        "mining": {
          "$ref": "#/$defs/d14_proxyIdentity"
        },
        "staking": {
          "anyOf": [
            {
              "$ref": "#/$defs/d14_proxyIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "launch": {
          "anyOf": [
            {
              "$ref": "#/$defs/d13_address"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "core",
        "tokenFactory",
        "token",
        "genesis",
        "mining",
        "staking",
        "launch"
      ],
      "additionalProperties": false
    },
    "d15_eventType": {
      "enum": [
        "system.settlement_completed",
        "system.mining_checkpointed",
        "account.rewards_claimed",
        "account.claim_recipient_set",
        "account.rewards_staked",
        "account.sqk_staked",
        "account.sqk_unstaked",
        "nft.deposited",
        "nft.withdrawn",
        "nft.merged",
        "nft.launch_claimed",
        "measurement.distance_milestone",
        "measurement.daily_distance_milestone",
        "measurement.speed_milestone",
        "measurement.speed_record",
        "measurement.rpm_record",
        "measurement.distance_streak"
      ]
    },
    "d19_eventId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "d20_chainSource": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "chain"
        },
        "chainId": {
          "$ref": "#/$defs/d7_decimal"
        },
        "target": {
          "enum": [
            "anvil",
            "sepolia",
            "mainnet"
          ]
        },
        "releaseId": {
          "$ref": "#/$defs/d10_versionId"
        },
        "contractAddress": {
          "$ref": "#/$defs/d13_address"
        },
        "blockNumber": {
          "$ref": "#/$defs/d7_decimal"
        },
        "blockHash": {
          "$ref": "#/$defs/d8_bytes32"
        },
        "transactionHash": {
          "$ref": "#/$defs/d8_bytes32"
        },
        "transactionIndex": {
          "$ref": "#/$defs/d7_decimal"
        },
        "logIndex": {
          "$ref": "#/$defs/d7_decimal"
        },
        "confirmationStatus": {
          "const": "safe"
        }
      },
      "required": [
        "kind",
        "chainId",
        "target",
        "releaseId",
        "contractAddress",
        "blockNumber",
        "blockHash",
        "transactionHash",
        "transactionIndex",
        "logIndex",
        "confirmationStatus"
      ],
      "additionalProperties": false
    },
    "d18_chainEnvelopeV2": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/d19_eventId"
        },
        "eventVersion": {
          "const": 2
        },
        "occurredAt": {
          "$ref": "#/$defs/d4_timestamp"
        },
        "recordedAt": {
          "$ref": "#/$defs/d4_timestamp"
        },
        "source": {
          "$ref": "#/$defs/d20_chainSource"
        }
      },
      "required": [
        "id",
        "eventVersion",
        "occurredAt",
        "recordedAt",
        "source"
      ]
    },
    "d17_settlementCompleted": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/d18_chainEnvelopeV2"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "system.settlement_completed"
            },
            "payload": {
              "type": "object",
              "properties": {
                "previousSettledThroughRound": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "settledThroughRound": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "activeRoundCount": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "workAdded": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "completedBlockCount": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "firstCompletedBlock": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/d7_decimal"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lastCompletedBlock": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/d7_decimal"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cumulativeWork": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "blockHeight": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "cumulativeBlockUnits": {
                  "$ref": "#/$defs/d7_decimal"
                }
              },
              "required": [
                "previousSettledThroughRound",
                "settledThroughRound",
                "activeRoundCount",
                "workAdded",
                "completedBlockCount",
                "firstCompletedBlock",
                "lastCompletedBlock",
                "cumulativeWork",
                "blockHeight",
                "cumulativeBlockUnits"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "payload"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "d22_eventAsset": {
      "type": "object",
      "properties": {
        "address": {
          "$ref": "#/$defs/d13_address"
        },
        "symbol": {
          "type": "string",
          "pattern": "^[A-Z0-9]{1,16}$"
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      },
      "required": [
        "address",
        "symbol",
        "decimals"
      ],
      "additionalProperties": false
    },
    "d21_miningCheckpointed": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/d18_chainEnvelopeV2"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "system.mining_checkpointed"
            },
            "payload": {
              "type": "object",
              "properties": {
                "completedBlockCount": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "cumulativeWork": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "amountBaseUnits": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "asset": {
                  "$ref": "#/$defs/d22_eventAsset"
                },
                "afterRound": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "throughRound": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "cumulativeBlockUnits": {
                  "$ref": "#/$defs/d7_decimal"
                }
              },
              "required": [
                "afterRound",
                "throughRound",
                "completedBlockCount",
                "cumulativeWork",
                "amountBaseUnits",
                "asset",
                "cumulativeBlockUnits"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "payload"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "d24_chainEnvelopeV1": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/d19_eventId"
        },
        "eventVersion": {
          "const": 1
        },
        "occurredAt": {
          "$ref": "#/$defs/d4_timestamp"
        },
        "recordedAt": {
          "$ref": "#/$defs/d4_timestamp"
        },
        "source": {
          "$ref": "#/$defs/d20_chainSource"
        }
      },
      "required": [
        "id",
        "eventVersion",
        "occurredAt",
        "recordedAt",
        "source"
      ]
    },
    "d23_accountRewardsClaimed": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/d24_chainEnvelopeV1"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "account.rewards_claimed"
            },
            "payload": {
              "type": "object",
              "properties": {
                "account": {
                  "$ref": "#/$defs/d13_address"
                },
                "recipient": {
                  "$ref": "#/$defs/d13_address"
                },
                "amountBaseUnits": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "asset": {
                  "$ref": "#/$defs/d22_eventAsset"
                }
              },
              "required": [
                "account",
                "recipient",
                "amountBaseUnits",
                "asset"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "payload"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "d25_accountClaimRecipientSet": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/d24_chainEnvelopeV1"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "account.claim_recipient_set"
            },
            "payload": {
              "type": "object",
              "properties": {
                "account": {
                  "$ref": "#/$defs/d13_address"
                },
                "recipient": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/d13_address"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "account",
                "recipient"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "payload"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "d26_accountRewardsStaked": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/d24_chainEnvelopeV1"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "account.rewards_staked"
            },
            "payload": {
              "type": "object",
              "properties": {
                "account": {
                  "$ref": "#/$defs/d13_address"
                },
                "amountBaseUnits": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "principalBaseUnits": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "freshUntilRound": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "asset": {
                  "$ref": "#/$defs/d22_eventAsset"
                }
              },
              "required": [
                "account",
                "amountBaseUnits",
                "principalBaseUnits",
                "freshUntilRound",
                "asset"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "payload"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "d27_accountSqkStaked": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/d24_chainEnvelopeV1"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "account.sqk_staked"
            },
            "payload": {
              "type": "object",
              "properties": {
                "account": {
                  "$ref": "#/$defs/d13_address"
                },
                "amountBaseUnits": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "principalBaseUnits": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "freshUntilRound": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "asset": {
                  "$ref": "#/$defs/d22_eventAsset"
                }
              },
              "required": [
                "account",
                "amountBaseUnits",
                "principalBaseUnits",
                "freshUntilRound",
                "asset"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "payload"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "d28_accountSqkUnstaked": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/d18_chainEnvelopeV2"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "account.sqk_unstaked"
            },
            "payload": {
              "type": "object",
              "properties": {
                "account": {
                  "$ref": "#/$defs/d13_address"
                },
                "amountBaseUnits": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "feeBaseUnits": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "netBaseUnits": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "asset": {
                  "$ref": "#/$defs/d22_eventAsset"
                }
              },
              "required": [
                "account",
                "amountBaseUnits",
                "feeBaseUnits",
                "netBaseUnits",
                "asset"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "payload"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "d29_nftDeposited": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/d24_chainEnvelopeV1"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "nft.deposited"
            },
            "payload": {
              "type": "object",
              "properties": {
                "account": {
                  "$ref": "#/$defs/d13_address"
                },
                "collection": {
                  "$ref": "#/$defs/d13_address"
                },
                "tokenId": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "basePower": {
                  "$ref": "#/$defs/d7_decimal"
                }
              },
              "required": [
                "account",
                "collection",
                "tokenId",
                "basePower"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "payload"
          ]
        }
      ],
