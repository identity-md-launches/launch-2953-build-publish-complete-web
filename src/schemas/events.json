    },
    "d30_nftWithdrawn": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/d24_chainEnvelopeV1"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "nft.withdrawn"
            },
            "payload": {
              "type": "object",
              "properties": {
                "account": {
                  "$ref": "#/$defs/d13_address"
                },
                "collection": {
                  "$ref": "#/$defs/d13_address"
                },
                "tokenId": {
                  "$ref": "#/$defs/d7_decimal"
                },
