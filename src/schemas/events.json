    "d31_nftMerged": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/d24_chainEnvelopeV1"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "nft.merged"
            },
            "payload": {
              "type": "object",
              "properties": {
                "account": {
                  "$ref": "#/$defs/d13_address"
                },
                "collection": {
                  "$ref": "#/$defs/d13_address"
                },
                "survivorTokenId": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "donorTokenId": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "level": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 10
                },
                "nextMergeHeight": {
                  "$ref": "#/$defs/d7_decimal"
                },
                "custody": {
                  "enum": [
                    "wallet",
                    "staking"
                  ]
                },
                "nftPowerDelta": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/d7_decimal"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "account",
                "collection",
                "survivorTokenId",
                "donorTokenId",
                "level",
                "nextMergeHeight",
                "custody",
                "nftPowerDelta"
              ],
              "additionalProperties": false,
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "custody": {
                      "const": "wallet"
                    },
                    "nftPowerDelta": {
                      "type": "null"
                    }
                  }
                },
                {
                  "type": "object",
                  "properties": {
                    "custody": {
                      "const": "staking"
                    },
                    "nftPowerDelta": {
                      "$ref": "#/$defs/d7_decimal"
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "type",
            "payload"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "d32_nftLaunchClaimed": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/d24_chainEnvelopeV1"
        },
        {
          "type": "object",
