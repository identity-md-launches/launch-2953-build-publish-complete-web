              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "payload"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "d35_measurementSource": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "measurement"
        },
        "installationId": {
          "$ref": "#/$defs/d2_installationId"
        },
        "receiptCursor": {
          "$ref": "#/$defs/d7_decimal"
        },
        "telemetryId": {
          "type": "string",
          "format": "uuid"
        },
        "observedAt": {
          "$ref": "#/$defs/d4_timestamp"
        },
        "receivedAt": {
          "$ref": "#/$defs/d4_timestamp"
        },
